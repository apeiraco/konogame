{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/dist-tsc",
      "!!projections",
      // These projections belong to dev-cli release sync.
      "!packages/contracts/src/version.ts",
      "!extensions/filesystem/src/metadata.ts",
      "!extensions/steam/src/metadata.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  // Documentation layout remains owned by its authors; dev-cli validates bilingual links.
  "markdown": {
    "formatter": { "enabled": false }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConstEnum": "error" },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "reflect-metadata": "Use owner Effect Context.Service tags and Layers without reflection metadata.",
              "injection-js": "Use owner Effect Context.Service tags and Layers.",
              "rxjs": "Use native Effect Streams and scoped fibers."
            },
            "patterns": [
              {
                "group": ["reflect-metadata/**"],
                "message": "Use owner Effect Context.Service tags and Layers without reflection metadata."
              },
              {
                "group": ["injection-js/**"],
                "message": "Use owner Effect Context.Service tags and Layers."
              },
              {
                "group": ["rxjs/**"],
                "message": "Use native Effect Streams and scoped fibers."
              }
            ]
          }
        },
        // Record graphs and AST indices are validated before these assertions.
        "noNonNullAssertion": "off",
        "noEnum": "error",
        "useImportType": {
          "level": "error",
          "options": { "style": "inlineType" }
        },
        "useExportType": {
          "level": "error",
          "options": { "style": "inlineType" }
        },
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": { "organizeImports": "on" }
    }
  },
  "overrides": [
    {
      // pnpm owns the generated lockfile serialization.
      "includes": ["pnpm-lock.yaml"],
      "formatter": { "enabled": false }
    },
    {
      // Preserve the release synchronizer's deterministic JSON serialization.
      "includes": ["**/package.json"],
      "formatter": { "enabled": false }
    }
  ]
}
