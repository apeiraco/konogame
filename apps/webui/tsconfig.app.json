{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "./src",
    "outDir": "./dist-tsc/app",
    "tsBuildInfoFile": "./dist-tsc/app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "dist-tsc", "src/**/__tests__/**"],
  "references": [
    {
      "path": "../../packages/game/tsconfig.lib.json"
    },
    {
      "path": "../../packages/workspace/tsconfig.lib.json"
    },
    {
      "path": "../../packages/infrastructure/tsconfig.lib.json"
    }
  ]
}
