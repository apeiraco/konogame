{
  "name": "konogame",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build --cache=local:rw",
    "typecheck": "tsc --build",
    "test": "turbo run test:run --cache=local:rw --",
    "test:run": "vitest run",
    "check": "turbo run lint:run typecheck:run test:run check:docs check:release --cache=local:rw",
    "lint:run": "pnpm lint",
    "typecheck:run": "pnpm typecheck",
    "check:docs": "node scripts/dev-cli/dist/main.js check-docs",
    "check:release": "node scripts/dev-cli/dist/main.js release check",
    "cli": "node apps/cli/dist/main.js",
    "daemon": "node apps/daemon/dist/main.js",
    "dev-cli": "node scripts/dev-cli/dist/main.js",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@konogame/cli": "workspace:*",
    "@konogame/contracts": "workspace:*",
    "@konogame/infrastructure": "workspace:*",
    "@konogame/daemon": "workspace:*",
    "@konogame/dev-cli": "workspace:*",
    "@konogame/extension-discovery-node": "workspace:*",
    "@konogame/extension-filesystem": "workspace:*",
    "@konogame/extension-steam": "workspace:*",
    "@konogame/game": "workspace:*",
    "@konogame/save": "workspace:*",
    "@konogame/workspace": "workspace:*",
    "@konogame/workspace-configuration": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "cli-testing-library": "catalog:",
    "execa": "catalog:",
    "node-pty": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "@optique/testing": "catalog:",
    "vitest": "catalog:",
    "effect": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:"
  },
  "version": "0.1.0-alpha.0",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apeiraco/konogame.git"
  },
  "konogame": {
    "releaseGroup": "core",
    "contractRange": ">=0.2.0 <0.3.0"
  },
  "description": "An extensible, capability-oriented framework for managing game assets."
}
