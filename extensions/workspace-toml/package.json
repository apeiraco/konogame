  "scripts": {
    "build": "tsdown"
  },
  "files": [
    "dist"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apeiraco/konogame.git"
  },
  "konogame": {
    "releaseGroup": "extension",
    "extensionId": "konogame.workspace-toml",
    "declarationProtocolRange": ">=0.2.0 <0.3.0",
    "portVersionRanges": {
      "workspace-toml.configuration": ">=0.2.0 <0.3.0"
    },
    "software": {
      "toml": ">=1.0.0 <1.1.0"
    }
