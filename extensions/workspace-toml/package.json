{
  "name": "@konogame/extension-workspace-toml",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "exports": {
    ".": {
      "monorepo-tsc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "monorepo-tsc": "./src/providers.ts",
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./manifest": {
      "monorepo-tsc": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "dependencies": {
    "@konogame/workspace": "workspace:*",
    "@konogame/extension-filesystem": "workspace:*",
    "arktype": "catalog:",
    "uuid": "catalog:",
    "toml-eslint-parser": "catalog:",
    "@konogame/infrastructure": "workspace:*",
    "effect": "catalog:"
