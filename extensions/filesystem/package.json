{
  "name": "@konogame/extension-filesystem",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "exports": {
    ".": {
      "monorepo-tsc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "monorepo-tsc": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./providers": {
      "monorepo-tsc": "./src/providers.ts",
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./location": {
      "monorepo-tsc": "./src/location/values.ts",
      "types": "./dist/location/values.d.ts",
      "import": "./dist/location/values.js"
    }
  },
  "dependencies": {
    "@konogame/save": "workspace:*",
    "arktype": "catalog:",
    "uuid": "catalog:",
    "@konogame/game": "workspace:*",
    "semver": "catalog:",
    "@konogame/infrastructure": "workspace:*",
    "effect": "catalog:",
    "@konogame/workspace": "workspace:*"
  },
  "scripts": {
    "build": "tsdown"
  },
  "files": [
    "dist"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/apeiraco/konogame.git"
  },
  "konogame": {
    "releaseGroup": "extension",
    "extensionId": "konogame.filesystem",
    "declarationProtocolRange": ">=0.2.0 <0.3.0",
    "portVersionRanges": {
      "filesystem.save-store": ">=0.2.0 <0.3.0",
      "filesystem.location": ">=0.2.0 <0.3.0",
      "filesystem.game-discovery": ">=0.3.0 <0.4.0"
    },
    "software": {
      "node": ">=26"
    }
  }
}
